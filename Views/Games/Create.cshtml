@{
    ViewData["Title"] = "Add Game";
}
<h1>Add New Game</h1>
<form>
    <label>Title</label>
    <input type="text">
    <label>Genre</label>
    <input type="text">
    <label>Platform</label>
    <input type="text">
    <label>Developer</label>
    <input type="text">
    <label>Publisher</label>
    <input type="text">
    <label>Release Date</label>
    <input type="date">
    <label>Rating</label>
    <input type="number">
    <label>Description</label>
    <textarea rows="5"></textarea>
    <button class="button">
        Save
    </button>
</form>