<div class="game-card">
    <h2>Game Title</h2>
    <p><strong>Genre:</strong> Genre Here</p>
    <p><strong>Platform:</strong> Platform Here</p>
    <p><strong>Developer:</strong> Developer Here</p>
    <div class="card-buttons">
        <a asp-controller="Games"
           asp-action="Details"
           class="button">
            Details
        </a>
        <a asp-controller="Games"
           asp-action="Edit"
           class="button secondary">
            Edit
        </a>
        <a asp-controller="Games"
           asp-action="Delete"
           class="button danger">
            Delete
        </a>
    </div>
</div>