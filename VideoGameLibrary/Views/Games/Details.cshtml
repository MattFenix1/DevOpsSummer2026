@model VideoGameLibrary.Models.Game
@{
    ViewData["Title"] = "Game Details";
}
<div class="container">
    <h1>Game Details</h1>
    <div class="card mt-4">
        <div class="card-body">
            <h2 class="card-title">@Model.Title</h2>
            <hr />
            <p>
                <strong>Genre:</strong>
                @Model.Genre
            </p>
            <p>
                <strong>Developer:</strong>
                @Model.Developer
            </p>
            <p>
                <strong>Platform:</strong>
                @Model.Platform
            </p>
            <p>
                <strong>Release Date:</strong>
                @Model.ReleaseDate.ToString("MMMM dd, yyyy")
            </p>
            <p>
                <strong>Description:</strong>
                @Model.Description
            </p>
            <div class="mt-4">
                <a asp-action="Index"
                       class="btn btn-secondary">
                    Back to Library
                </a>
                <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                    Edit
                </a>
                <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger">
                    Delete
                </a>
            </div>
        </div>
    </div>
</div>